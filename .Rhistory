read_and_combine_dfs <- function(object_surprisals, subject_surprisals) {
full_surprisals.object <- read_csv(object_surprisals)
full_surprisals.gpt.subject <- read_csv(subject_surprisals)
surprisals_df.object <- data.frame(
"id" = full_surprisals.gpt.object$sentence_group,
"wh" = as_factor(full_surprisals.gpt.object$wh),
"gap" = as_factor(full_surprisals.gpt.object$gap),
"condition" = full_surprisals.gpt.object$condition,
"embed" = full_surprisals.gpt.object$levels_of_embedding,
"surprisal" = full_surprisals.gpt.object$local_surprisal,
"gap_type" = "object")
surprisals_df.subject <- data.frame(
"id" = full_surprisals.gpt.subject$sentence_group,
"wh" = as_factor(full_surprisals.gpt.subject$wh),
"gap" = as_factor(full_surprisals.gpt.subject$gap),
"condition" = full_surprisals.gpt.subject$condition,
"embed" = full_surprisals.gpt.subject$levels_of_embedding,
"surprisal" = full_surprisals.gpt.subject$local_surprisal,
"gap_type" = "subject"
)
output <- rbind(surprisals_df.gpt.subject, surprisals_df.gpt.object)
output$gap_type <- as_factor(surprisals_df.gpt2$gap_type)
return (output)
}
